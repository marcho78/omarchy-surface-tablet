#!/bin/bash
# Type Cover watcher for Surface Pro 4.
# Cover detached: tablet mode on and the on-screen keyboard is available.
# Cover attached: desktop mode and the keyboard hides.
# Only acts when the cover state changes, so manual switches stick until then.
#   surface-osk          run the watcher (started from autostart.lua)
#   surface-osk toggle   show/hide the keyboard manually
#   surface-osk show|hide
#   surface-osk set style standard|full|simple
#   surface-osk set size small|medium|large
#   surface-osk set click on|off
#                        change the wvkbd layout and key click; saved in $SETTINGS
# Besides English, wvkbd shows your preferred language when it has a layout
# for it: the first one found in Hyprland's kb_layout, then $LANG.
#
# With squeekboard installed, the keyboard pops up by itself when a text field
# is tapped (while the cover is off). Without it, wvkbd is used and shows as
# soon as the cover comes off.

COVER=/dev/input/by-id/usb-Microsoft_Surface_Type_Cover-event-kbd
A11Y=org.gnome.desktop.a11y.applications

if command -v squeekboard >/dev/null; then
  OSK=squeekboard
else
  OSK=wvkbd-mobintl
fi

osk_dbus() {
  busctl --user "$@" sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 2>/dev/null
}

osk_show() {
  if [[ $OSK == squeekboard ]]; then
    osk_dbus call SetVisible b true
  else
    pkill -USR2 -x "$OSK"
  fi
}

osk_hide() {
  if [[ $OSK == squeekboard ]]; then
    osk_dbus call SetVisible b false
  else
    pkill -USR1 -x "$OSK"
  fi
}

# Pop up on text fields only while the cover is off.
osk_auto() {
  [[ $OSK == squeekboard ]] && gsettings set "$A11Y" screen-keyboard-enabled "$1"
}

# wvkbd layout settings, written by `surface-osk set` (the Control Center's
# Keyboard page) and read whenever wvkbd starts.
SETTINGS=$HOME/.config/surface-osk/settings
STYLE=standard
SIZE=medium
CLICK=on
[[ -f $SETTINGS ]] && source "$SETTINGS"

# The Surface Pro 4 has no vibration motor, so key presses get a soft click
# sound instead. Made with:
#   ffmpeg -f lavfi -i "anoisesrc=d=0.028:c=white:a=1:r=48000:seed=7" \
#     -af "bandpass=f=2800:width_type=h:w=2400,afade=t=out:st=0:d=0.028:curve=exp,volume=0.35" \
#     -ac 1 -ar 48000 -c:a pcm_s16le click.wav
CLICK_SOUND=$HOME/.local/share/surface-osk/click.wav

# The wvkbd layout for the preferred language, if any (English needs none).
preferred_language() {
  local code
  for code in $(hyprctl getoption input:kb_layout 2>/dev/null | sed -n 's/^str: //p' | tr ',' ' ') "${LANG%%_*}"; do
    case $code in
      gr | el) echo greek ;;
      ru | ua | uk | by | bg | rs | sr | mk | kz | kk) echo cyrillic ;;
      ara | ar | eg | sa | iq | ma | dz | sy) echo arabic ;;
      ir | fa) echo persian ;;
      il | he) echo hebrew ;;
      ge | ka) echo georgian ;;
      *) continue ;;
    esac
    return
  done
}

# Each style is a cycle of layers (the layer key steps through them); the
# preferred language joins the cycle after the main layout.
wvkbd_args() {
  local landscape portrait extra="" height lang
  case $STYLE in
    full) landscape=fullwide portrait=full ;;
    simple) landscape=simple portrait=simple ;;
    *) landscape=landscape portrait=full ;;
  esac
  lang=$(preferred_language)
  [[ -n $lang ]] && extra=",$lang"
  case $SIZE in
    small) height=240 ;;
    large) height=360 ;;
    *) height=300 ;;
  esac
  echo "--landscape-layers $landscape$extra,landscapespecial,emoji" \
    "-l $portrait$extra,special,emoji" \
    "-L $height -H $((height * 4 / 3))"
}

start_wvkbd() {
  if [[ $CLICK == on && -f $CLICK_SOUND ]]; then
    # wvkbd -o prints each key the moment it is pressed; `surface-osk clicks`
    # plays a click for each.
    # shellcheck disable=SC2046,SC2016
    setsid -f bash -c 'wvkbd-mobintl -o "$@" | "$0" clicks' "$HOME/.local/bin/surface-osk" \
      "$@" $(wvkbd_args) >/dev/null 2>&1
  else
    # shellcheck disable=SC2046
    setsid -f wvkbd-mobintl "$@" $(wvkbd_args) >/dev/null 2>&1
  fi
}

# Key clicks, fed by wvkbd -o (see start_wvkbd): one character per key, no
# newlines. The sound is loaded into the sound server once, so each click is
# just a play request (about 10 ms) rather than a player starting up.
if [[ $1 == clicks ]]; then
  if pactl upload-sample "$CLICK_SOUND" surface-osk-click >/dev/null 2>&1; then
    click() { pactl play-sample surface-osk-click >/dev/null 2>&1 & }
  else
    click() { pw-play "$CLICK_SOUND" >/dev/null 2>&1 & }
  fi
  while IFS= read -r -n1 -d '' _; do click; done
  exit
fi

if [[ $1 == set ]]; then
  case $2 in
    style) [[ $3 =~ ^(standard|full|simple)$ ]] && STYLE=$3 ;;
    size) [[ $3 =~ ^(small|medium|large)$ ]] && SIZE=$3 ;;
    click) [[ $3 =~ ^(on|off)$ ]] && CLICK=$3 ;;
    *) echo "Usage: surface-osk set style|size|click VALUE" >&2; exit 1 ;;
  esac
  mkdir -p "$(dirname "$SETTINGS")"
  printf 'STYLE=%s\nSIZE=%s\nCLICK=%s\n' "$STYLE" "$SIZE" "$CLICK" >"$SETTINGS"
  if [[ $OSK == wvkbd-mobintl ]] && pgrep -x wvkbd-mobintl >/dev/null; then
    # Restart with the new layout, open again if it was open.
    if hyprctl layers -j | grep -q '"namespace": "wvkbd"'; then shown=1; else shown=""; fi
    pkill -x wvkbd-mobintl
    while pgrep -x wvkbd-mobintl >/dev/null; do sleep 0.05; done
    if [[ -n $shown ]]; then start_wvkbd; else start_wvkbd --hidden; fi
  fi
  exit
fi

case $1 in
  show) osk_show; exit ;;
  hide) osk_hide; exit ;;
esac

if [[ $1 == toggle ]]; then
  if [[ $OSK == squeekboard ]]; then
    if [[ $(osk_dbus get-property Visible) == "b true" ]]; then osk_hide; else osk_show; fi
  else
    pkill -RTMIN -x "$OSK"
  fi
  exit
fi

# Restart cleanly if already running
PIDFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-osk.pid
if [[ -f $PIDFILE ]]; then
  OLD=$(cat "$PIDFILE")
  pkill -P "$OLD" 2>/dev/null
  kill "$OLD" 2>/dev/null
fi
echo $$ >"$PIDFILE"
pkill -x squeekboard
pkill -x wvkbd-mobintl

if [[ $OSK == squeekboard ]]; then
  squeekboard &
else
  start_wvkbd --hidden
fi

LAST=""

sync_state() {
  local now
  [[ -e $COVER ]] && now=attached || now=detached
  [[ $now == "$LAST" ]] && return
  LAST=$now

  if [[ $now == attached ]]; then
    osk_auto false
    osk_hide
    "$HOME"/.local/bin/tablet-mode off
  else
    "$HOME"/.local/bin/tablet-mode on
    osk_auto true
    # squeekboard waits for a text field; wvkbd has no way to know, so show it.
    [[ $OSK == squeekboard ]] || osk_show
  fi
}

sleep 1
sync_state

# React to input devices being added/removed (cover attach/detach)
udevadm monitor --udev --subsystem-match=input 2>/dev/null |
  while read -r line; do
    [[ $line == UDEV* ]] || continue
    sleep 0.5
    sync_state
  done
