#!/bin/bash
# Type Cover watcher for Surface Pro 4.
# Cover detached: tablet mode on and the on-screen keyboard is available.
# Cover attached: desktop mode and the keyboard hides.
# Only acts when the cover state changes, so manual switches stick until then.
#   surface-osk          run the watcher (started from autostart.lua)
#   surface-osk toggle   show/hide the keyboard manually
#   surface-osk show|hide
#   surface-osk restart  restart the keyboard (after updating wvkbd, say), keeping
#                        it open or hidden as it was
#   surface-osk set style standard|numbers
#   surface-osk set size small|medium|large
#   surface-osk set click on|off
#   surface-osk set predict on|off
#                        change the wvkbd layout, key click and word suggestions;
#                        saved in $SETTINGS
#   surface-osk accept N | reset | forget
#                        the suggestion strip's commands for surface-osk-keys: type
#                        suggestion N, start the word over, forget learned words
# Besides English, wvkbd shows your preferred language when it has a layout
# for it: the first one found in Hyprland's kb_layout, then $LANG.
#
# With squeekboard installed, the keyboard pops up by itself when a text field
# is tapped (while the cover is off). Without it, wvkbd is used and shows as
# soon as the cover comes off.

COVER=/dev/input/by-id/usb-Microsoft_Surface_Type_Cover-event-kbd
A11Y=org.gnome.desktop.a11y.applications

if command -v squeekboard >/dev/null; then
  OSK=squeekboard
else
  OSK=wvkbd-mobintl
fi

osk_dbus() {
  busctl --user "$@" sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 2>/dev/null
}

osk_show() {
  if [[ $OSK == squeekboard ]]; then
    osk_dbus call SetVisible b true
  else
    pkill -USR2 -x "$OSK"
  fi
}

osk_hide() {
  if [[ $OSK == squeekboard ]]; then
    osk_dbus call SetVisible b false
  else
    pkill -USR1 -x "$OSK"
  fi
}

# Pop up on text fields only while the cover is off.
osk_auto() {
  [[ $OSK == squeekboard ]] && gsettings set "$A11Y" screen-keyboard-enabled "$1"
}

# wvkbd layout settings, written by `surface-osk set` (the Control Center's
# Keyboard page) and read whenever wvkbd starts.
SETTINGS=$HOME/.config/surface-osk/settings
STYLE=standard
SIZE=medium
CLICK=on
PREDICT=on
[[ -f $SETTINGS ]] && source "$SETTINGS"

# The Surface Pro 4 has no vibration motor, so key presses get a soft click
# sound instead. Made with:
#   ffmpeg -f lavfi -i "anoisesrc=d=0.028:c=white:a=1:r=48000:seed=7" \
#     -af "bandpass=f=2800:width_type=h:w=2400,afade=t=out:st=0:d=0.028:curve=exp,volume=0.35" \
#     -ac 1 -ar 48000 -c:a pcm_s16le click.wav
CLICK_SOUND=$HOME/.local/share/surface-osk/click.wav

# The wvkbd layout for the preferred language, if any (English needs none).
preferred_language() {
  local code
  for code in $(hyprctl getoption input:kb_layout 2>/dev/null | sed -n 's/^str: //p' | tr ',' ' ') "${LANG%%_*}"; do
    case $code in
      gr | el) echo greek ;;
      ru | ua | uk | by | bg | rs | sr | mk | kz | kk) echo cyrillic ;;
      ara | ar | eg | sa | iq | ma | dz | sy) echo arabic ;;
      ir | fa) echo persian ;;
      il | he) echo hebrew ;;
      ge | ka) echo georgian ;;
      *) continue ;;
    esac
    return
  done
}

# The layouts are our own (packages/wvkbd/us-layout.patch): standard US QWERTY
# like Gboard's, with ?123 and =\< symbol pages; "numbers" adds a number row,
# and the keyboard grows a fifth taller so the keys keep their size. The
# preferred language's layout follows in the list, though these layouts have
# no key to step to it yet.
wvkbd_args() {
  local letters extra="" height lang
  case $STYLE in
    numbers | full) letters=usnum ;;
    *) letters=us ;;
  esac
  lang=$(preferred_language)
  [[ -n $lang ]] && extra=",$lang"
  case $SIZE in
    small) height=240 ;;
    large) height=360 ;;
    *) height=300 ;;
  esac
  [[ $letters == usnum ]] && height=$((height * 5 / 4))
  # A wvkbd without our layouts (not yet updated) would refuse to start.
  if ! wvkbd-mobintl --list-layers 2>/dev/null | grep -qx us; then
    echo "--landscape-layers landscape$extra,landscapespecial -l full$extra,special -L 300 -H 400"
    return
  fi
  echo "--landscape-layers $letters,ussym,usmore$extra" \
    "-l $letters,ussym,usmore$extra" \
    "-L $height -H $((height * 4 / 3))"
}

# Key clicks and word suggestions both come from surface-osk-keys, fed by
# wvkbd -o, which prints each key the moment it is pressed.
start_wvkbd() {
  local keys=()
  [[ $CLICK == on && -f $CLICK_SOUND ]] && keys+=(--click "$CLICK_SOUND")
  [[ $PREDICT == on ]] && keys+=(--predict)
  if ((${#keys[@]})); then
    # shellcheck disable=SC2046,SC2016
    setsid -f bash -c 'wvkbd-mobintl -o "$@" | "$0" '"${keys[*]@Q}" "$HOME/.local/bin/surface-osk-keys" \
      "$@" $(wvkbd_args) >/dev/null 2>&1
  else
    # shellcheck disable=SC2046
    setsid -f wvkbd-mobintl "$@" $(wvkbd_args) >/dev/null 2>&1
  fi
}

# The suggestion strip's commands, for surface-osk-keys (see its header).
CONTROL=${XDG_RUNTIME_DIR:-/tmp}/surface-osk/control
case $1 in
  accept | reset | forget)
    [[ $1 == forget ]] && rm -f "$HOME/.local/share/surface-osk/learned.json"
    # Only when surface-osk-keys is reading, so the write can't hang.
    if [[ -p $CONTROL ]] && pgrep -f surface-osk-keys >/dev/null; then
      timeout 1 bash -c 'printf "%s\n" "$1" >"$2"' _ "$*" "$CONTROL"
    fi
    exit
    ;;
esac

restart_wvkbd() {
  if [[ $OSK == wvkbd-mobintl ]] && pgrep -x wvkbd-mobintl >/dev/null; then
    # Restart with the current settings, open again if it was open.
    if hyprctl layers -j | grep -q '"namespace": "wvkbd"'; then shown=1; else shown=""; fi
    pkill -x wvkbd-mobintl
    while pgrep -x wvkbd-mobintl >/dev/null; do sleep 0.05; done
    if [[ -n $shown ]]; then start_wvkbd; else start_wvkbd --hidden; fi
  fi
}

if [[ $1 == restart ]]; then
  restart_wvkbd
  exit
fi

if [[ $1 == set ]]; then
  case $2 in
    style) [[ $3 =~ ^(standard|numbers)$ ]] && STYLE=$3 ;;
    size) [[ $3 =~ ^(small|medium|large)$ ]] && SIZE=$3 ;;
    click) [[ $3 =~ ^(on|off)$ ]] && CLICK=$3 ;;
    predict) [[ $3 =~ ^(on|off)$ ]] && PREDICT=$3 ;;
    *) echo "Usage: surface-osk set style|size|click|predict VALUE" >&2; exit 1 ;;
  esac
  mkdir -p "$(dirname "$SETTINGS")"
  printf 'STYLE=%s\nSIZE=%s\nCLICK=%s\nPREDICT=%s\n' "$STYLE" "$SIZE" "$CLICK" "$PREDICT" >"$SETTINGS"
  restart_wvkbd
  exit
fi

case $1 in
  show) osk_show; exit ;;
  hide) osk_hide; exit ;;
esac

if [[ $1 == toggle ]]; then
  if [[ $OSK == squeekboard ]]; then
    if [[ $(osk_dbus get-property Visible) == "b true" ]]; then osk_hide; else osk_show; fi
  else
    pkill -RTMIN -x "$OSK"
  fi
  exit
fi

# Restart cleanly if already running
PIDFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-osk.pid
if [[ -f $PIDFILE ]]; then
  OLD=$(cat "$PIDFILE")
  pkill -P "$OLD" 2>/dev/null
  kill "$OLD" 2>/dev/null
fi
echo $$ >"$PIDFILE"
pkill -x squeekboard
pkill -x wvkbd-mobintl

if [[ $OSK == squeekboard ]]; then
  squeekboard &
else
  start_wvkbd --hidden
fi

LAST=""

sync_state() {
  local now
  [[ -e $COVER ]] && now=attached || now=detached
  [[ $now == "$LAST" ]] && return
  LAST=$now

  if [[ $now == attached ]]; then
    osk_auto false
    osk_hide
    "$HOME"/.local/bin/tablet-mode off
  else
    "$HOME"/.local/bin/tablet-mode on
    osk_auto true
    # squeekboard waits for a text field; wvkbd has no way to know, so show it.
    [[ $OSK == squeekboard ]] || osk_show
  fi
}

sleep 1
sync_state

# React to input devices being added/removed (cover attach/detach)
udevadm monitor --udev --subsystem-match=input 2>/dev/null |
  while read -r line; do
    [[ $line == UDEV* ]] || continue
    sleep 0.5
    sync_state
  done
