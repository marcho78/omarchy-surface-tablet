# The AUR wvkbd package, plus two touch fixes:
#   hold-to-repeat.patch  upstream releases a key on any finger movement, so with
#                         the Surface's jittery touch a held backspace never repeats
#   key-linger.patch      a tapped key stays lit (with its popup) for 150 ms after
#                         the finger lifts; a tap lasts only a few frames otherwise
#   key-preview.patch     the popup is a magnified preview above the key, as on
#                         phone keyboards: a slightly bigger bubble, the character
#                         at 1.5x, only for keys that type a character
#   us-layout.patch       standard US QWERTY layouts like Gboard's (us, usnum with
#                         a number row, ussym, usmore), even key sizes, and an
#                         bottom row Ctrl, Omarchy (Super, drawn with Omarchy's own
#                         font) and Alt, so Omarchy's shortcuts can be typed
# Build and install with:  makepkg -si
#
# Maintainer: Ash <xash at riseup d0t net>
# Contributor: Aren <rn+aur@peacevolution.org>

pkgname=wvkbd
pkgver=0.20
pkgrel=1.10
pkgdesc='On-screen keyboard for wlroots (touch fixes: held keys repeat, magnified key previews)'
url='https://git.sr.ht/~proycon/wvkbd'
arch=('x86_64' 'i686' 'armv7h' 'aarch64')
license=('GPL3')
depends=('wayland' 'pango' 'cairo' 'glibc')
makedepends=('fontconfig' 'libxkbcommon' 'scdoc')
source=("$pkgname-$pkgver.tar.gz::https://git.sr.ht/~proycon/wvkbd/archive/v$pkgver.tar.gz"
        'hold-to-repeat.patch'
        'key-linger.patch'
        'key-preview.patch'
        'us-layout.patch')
sha512sums=('1c5204dc00f7a3bdfd199dfa88b513c46249b7832ba546c0554940539fcc4e0d55303a9f6edd17dd82fd2893b602b86395202311b3ec851f5e8f41895f682371'
            'd36486e5e4e577cdeb89487143025e2147dea07f0304694650d7574a1ee02badaae62e0e90814200278565bf323e0af7a761ad5cbf902300fcb92d85107a788a'
            'b996032cde99d809ff2c4698df907fc6eb0da3e8a91e213bf15d5c3a72115b370e0f6db98a8470c1b611e0093fabfc8545b0b8f188442985c28f0d33b39e57a8'
            '8ce27b53ebf3194aab45492053b9640908e3ceb17c11e7795f5130980468b0ff29481e76ba37a0ec5d9e9816daeaebe015d104d7d88abc0eba4bf32431f805fb'
            'ab9720b014920480c6c9dff391531822dad005b02a1d2ac66e468c1f72c02c827c87a00965b626aeb1d9f6792d4487a69a89dd7adb44cf4bf222d4eb00a14b2e')

prepare() {
  # The Makefile makes build-mobintl/config.h only when it is missing, so one
  # left over from an earlier build would keep the old config (colour schemes).
  rm -rf "$pkgname-v$pkgver/build-mobintl"
  patch -d "$pkgname-v$pkgver" -p1 <hold-to-repeat.patch
  patch -d "$pkgname-v$pkgver" -p1 <key-linger.patch
  patch -d "$pkgname-v$pkgver" -p1 <key-preview.patch
  patch -d "$pkgname-v$pkgver" -p1 <us-layout.patch
}

build() {
  make -C "$pkgname-v$pkgver"
}

package() {
  make -C "$pkgname-v$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
}
