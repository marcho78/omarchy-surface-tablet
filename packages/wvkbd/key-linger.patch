+/* How long a tapped key stays lit after the finger lifts. A tap on a
+ * touchscreen lasts only a few frames, too quick to see which key it hit. */
+#define KBD_LINGER_MS 150
+
+static void
+kbd_linger_arm(struct kbd *kb, int ms)
+{
+    struct itimerspec spec = {0};
+    spec.it_value.tv_sec = ms / 1000;
+    spec.it_value.tv_nsec = (long)(ms % 1000) * 1000000L;
+    if (kb->linger_fd > 0)
+        timerfd_settime(kb->linger_fd, 0, &spec, NULL);
+}
+
+/* Forget a lingering key without drawing it: the layout is being redrawn,
+ * or the keyboard surface is going away. */
+void
+kbd_linger_cancel(struct kbd *kb)
+{
+    kb->linger_key = NULL;
+    kbd_linger_arm(kb, 0);
+}
+
+/* Draw a lingering key released, and take its popup down unless another
+ * key is being held. */
+static void
+kbd_linger_end(struct kbd *kb)
+{
+    struct key *k = kb->linger_key;
+    if (!k)
+        return;
+    kbd_linger_cancel(kb);
+    if (k != kb->last_press)
+        kbd_draw_key(kb, k, None);
+    if (!kb->last_press)
+        kbd_clear_last_popup(kb);
+}
+
+void
+kbd_linger_expired(struct kbd *kb)
+{
+    kbd_linger_end(kb);
+}
