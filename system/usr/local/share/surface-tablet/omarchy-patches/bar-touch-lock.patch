--- plugins/bar/Bar.qml
+++ plugins/bar/Bar.qml
@@ -31,6 +31,21 @@
   // Manifest for the active bar option. Present for custom bars and useful for
   // diagnostics; the built-in bar does not otherwise need it.
   property var manifest: null
+
+  // Surface tablet patch: locked in tablet mode (~/.local/state/tablet-mode/
+  // state, written by tablet-mode). A finger always moves a little, so a tap on
+  // a widget became a drag that rearranged the bar, or moved it to another
+  // edge, and the tap was lost.
+  property bool touchLocked: false
+
+  FileView {
+    path: Quickshell.env("HOME") + "/.local/state/tablet-mode/state"
+    watchChanges: true
+    printErrors: false
+    onFileChanged: reload()
+    onLoaded: root.touchLocked = text().trim() === "on"
+    onLoadFailed: root.touchLocked = false
+  }
   QtObject {
     id: fallbackBarWidgetRegistry
     property var widgets: ({})
@@ -2066,7 +2081,7 @@
     pressAndHoldInterval: 200
 
     function startDrag(x, y) {
-      if (dragging) return
+      if (dragging || root.touchLocked) return
       dragging = true
       root.beginBarMove(root.targetWindow(gestureArea))
       var scenePoint = gestureArea.mapToItem(null, x, y)
@@ -2620,7 +2635,7 @@
       property bool suppressClick: false
       property real pressedX: 0
       property real pressedY: 0
-      readonly property bool canReorder: root.shell && typeof root.shell.mutateShellConfig === "function"
+      readonly property bool canReorder: root.shell && typeof root.shell.mutateShellConfig === "function" && !root.touchLocked
       readonly property real dragThreshold: Style.space(4)
 
       anchors.fill: parent
