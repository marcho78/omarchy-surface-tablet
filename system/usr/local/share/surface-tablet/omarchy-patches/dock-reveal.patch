     // The layout commands call this after changing a workspace's mode.
     function refresh(): void { root.refresh() }
     function apps(): void { appGrid.toggle() }
+    // Surface tablet patch: bring an auto-hidden dock up on the focused
+    // screen for a few seconds, as a touch on its edge does. Tablet mode's
+    // bottom swipe calls this.
+    function reveal(): void { root.revealFocused() }
+  }
+
+  function revealFocused() {
+    var monitor = Hyprland.focusedMonitor
+    var windows = docks.instances
+    for (var i = 0; i < windows.length; i++) {
+      var dockWindow = windows[i]
+      if (monitor && dockWindow.screen && dockWindow.screen.name !== monitor.name) continue
+      // revealByTouch comes with dock-autohide-touch.patch.
+      if (typeof dockWindow.revealByTouch === "function") dockWindow.revealByTouch()
+    }
   }
 
